FROM python:3.11-slim
WORKDIR /tts
RUN pip install --no-cache-dir 'supertonic==1.3.1' 'Flask>=3.1,<4'
# Exact model used for the approved M1 sample. Download at build time only.
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='supertone-oss-archive/supertonic-3', revision='aafc6e32416a594460b32413efc49d7fe4ce6d46', local_dir='/voices', allow_patterns=['onnx/*','voice_styles/M1.json','LICENSE'])"
RUN pip install --no-cache-dir 'gunicorn>=23,<26'
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 SUPERTONIC_INTRA_OP_THREADS=1 SUPERTONIC_INTER_OP_THREADS=1
COPY tts_server.py bounded_service.py ./
EXPOSE 5000
CMD ["python","bounded_service.py","gunicorn","--workers","1","--threads","2","--timeout","420","--bind","0.0.0.0:5000","tts_server:app"]
